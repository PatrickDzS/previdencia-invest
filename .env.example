# Copie este arquivo para .env e preencha com as credenciais do seu projeto Supabase.
# O URL deve ser a base do projeto (SEM /rest/v1).
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica-aqui

# Brapi Token (Opcional - Yahoo Finance funciona 100% gratuito sem token)
BRAPI_TOKEN=