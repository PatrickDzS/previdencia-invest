  },
  "scripts": {
    "start": "npx serve .",
    "build": "node -e \"const fs=require('fs');if(fs.existsSync('scripts/build-env.js')){require('child_process').execSync('node scripts/build-env.js',{stdio:'inherit'})}\" && node -v",
