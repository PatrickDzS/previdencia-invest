    "postinstall": "node -e \"const fs=require('fs');if(fs.existsSync('scripts/build-env.js')){require('child_process').execSync('node scripts/build-env.js',{stdio:'inherit'})}\"",
    "test": "node src/tests/mathEngine.test.js && node src/tests/importerService.test.js && node src/tests/notificationService.test.js"
  }
